import random, numpy as np
from tensorflow.keras.datasets import fashion_mnist
from tensorflow.keras.preprocessing.text import Tokenizer
from tensorflow.keras.preprocessing.sequence import pad_sequences
from tensorflow.keras.utils import to_categorical
from tensorflow.keras.models import Model
from tensorflow.keras.layers import *

(x_train, y_train), (x_test, y_test) = fashion_mnist.load_data()
x_train = x_train[:4000][..., None] / 255.0       # 4000 images, add channel, scale 0-1
labels  = y_train[:4000]

names = ["t-shirt", "trouser", "pullover", "dress", "coat",
         "sandal", "shirt", "sneaker", "bag", "ankle boot"]

# make a caption from each label
captions = ["startseq a photo of a " + names[l] + " endseq" for l in labels]

tok = Tokenizer()
tok.fit_on_texts(captions)
seqs = tok.texts_to_sequences(captions)            # "startseq a photo" -> [1, 2, 3]

vocab   = len(tok.word_index) + 1
max_len = max(len(s) for s in seqs)

X_img, X_txt, y = [], [], []
for img, s in zip(x_train, seqs):
    for t in range(1, len(s)):
        X_img.append(img)                                        # the image
        X_txt.append(pad_sequences([s[:t]], maxlen=max_len)[0])  # words so far
        y.append(s[t])                                           # next word

X_img, X_txt = np.array(X_img), np.array(X_txt)
y = to_categorical(y, vocab)

# image branch (CNN)
img_in = Input((28, 28, 1))
x = Conv2D(32, 3, activation="relu")(img_in)
x = MaxPooling2D()(x)
x = GlobalAveragePooling2D()(x)
img_vec = Dense(128, activation="relu")(x)

# text branch (LSTM)
txt_in = Input((max_len,))
t = Embedding(vocab, 128)(txt_in)
txt_vec = LSTM(128)(t)

# merge and predict next word
merged = Add()([img_vec, txt_vec])
out = Dense(vocab, activation="softmax")(Dense(128, activation="relu")(merged))

model = Model([img_in, txt_in], out)
model.compile(loss="categorical_crossentropy", optimizer="adam")

model.fit([X_img, X_txt], y, epochs=10, batch_size=64)

idx2word = {i: w for w, i in tok.word_index.items()}

def generate(img):
    text = "startseq"
    for _ in range(max_len):
        seq = pad_sequences(tok.texts_to_sequences([text]), maxlen=max_len)
        word = idx2word[np.argmax(model.predict([img[None], seq], verbose=0))]
        if word == "endseq": break
        text += " " + word
    return text.replace("startseq", "").strip()

test_img = x_test[0][..., None] / 255.0
print("True:", names[y_test[0]], "| Generated:", generate(test_img))
