import numpy as np
from tensorflow.keras.datasets import mnist
from tensorflow.keras.models import Model
from tensorflow.keras.layers import *

# 1. Data
(x_train, _), (x_test, _) = mnist.load_data()
x_train = x_train.reshape(-1, 784) / 255.0       # flatten + scale 0-1
x_test  = x_test.reshape(-1, 784) / 255.0

# 2. Model
inp  = Input((784,))
code = Dense(32, activation="relu")(inp)          # encoder (bottleneck)
out  = Dense(784, activation="sigmoid")(code)     # decoder

ae = Model(inp, out)
ae.compile(optimizer="adam", loss="mse")

# 3. Train (input = target)
ae.fit(x_train, x_train, epochs=10, batch_size=256)

# 4. Reconstruct
recon = ae.predict(x_test[:5])


import tensorflow as tf

# 1. Data: same as above

# 2. Sampling layer (reparameterization + KL loss)
class Sampling(Layer):
    def call(self, inputs):
        mu, log_var = inputs
        kl = -0.5 * tf.reduce_mean(tf.reduce_sum(1 + log_var - tf.square(mu) - tf.exp(log_var), axis=1))
        self.add_loss(kl)                                   # KL part of loss
        eps = tf.random.normal(tf.shape(mu))
        return mu + tf.exp(0.5 * log_var) * eps             # z = mu + sigma * eps

# 3. Encoder
inp     = Input((784,))
h       = Dense(128, activation="relu")(inp)
mu      = Dense(2)(h)                                       # mean
log_var = Dense(2)(h)                                       # spread
z       = Sampling()([mu, log_var])

# 4. Decoder
dec_in  = Input((2,))
dec_out = Dense(784, activation="sigmoid")(Dense(128, activation="relu")(dec_in))
decoder = Model(dec_in, dec_out)

# 5. VAE + reconstruction loss
vae = Model(inp, decoder(z))
vae.compile(optimizer="adam",
            loss=lambda y, p: 784 * tf.keras.losses.binary_crossentropy(y, p))
vae.fit(x_train, x_train, epochs=10, batch_size=128)

# 6. Generate NEW images from random numbers
new_images = decoder.predict(np.random.normal(size=(5, 2)))



import matplotlib.pyplot as plt

def show(original, recon, n=5):
    plt.figure(figsize=(10, 4))
    for i in range(n):
        plt.subplot(2, n, i + 1)                      # top row: original
        plt.imshow(original[i].reshape(28, 28), cmap="gray")
        plt.axis("off")

        plt.subplot(2, n, i + 1 + n)                  # bottom row: reconstructed
        plt.imshow(recon[i].reshape(28, 28), cmap="gray")
        plt.axis("off")
    plt.show()
