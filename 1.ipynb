import numpy as np, pandas as pd, matplotlib.pyplot as plt
from sklearn.preprocessing import MinMaxScaler
from sklearn.metrics import mean_squared_error, mean_absolute_error
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import SimpleRNN, LSTM, GRU, Dense, Dropout
from tensorflow.keras.callbacks import EarlyStopping

WINDOW = 60

# ---------- 1. LOAD + EDA ----------
def eda(df, col):
    print(df.head(), "\n", df.describe(), "\n", df.isnull().sum())
    df[col].plot(title="Time Series", figsize=(10, 3)); plt.show()
    df[col].rolling(30).mean().plot(title="30-step Rolling Mean"); plt.show()  # trend

# ---------- 2. PREPROCESS ----------
def make_windows(data, w):
    X, y = [], []
    for i in range(w, len(data)):
        X.append(data[i-w:i]); y.append(data[i])
    return np.array(X), np.array(y)

# ---------- 3. MODEL (swap layer type) ----------
def build_model(kind):
    layer = {"RNN": SimpleRNN, "LSTM": LSTM, "GRU": GRU}[kind]
    m = Sequential([layer(50, input_shape=(WINDOW, 1)), Dropout(0.2), Dense(1)])
    m.compile(optimizer="adam", loss="mse")
    return m

# ---------- 4. MAIN ----------
def main():
    # df = pd.read_csv("data.csv"); col = "value"
    t = np.arange(1000)                                  # demo data (replace with CSV)
    df = pd.DataFrame({"value": np.sin(0.05*t) + 0.1*np.random.randn(1000)}); col = "value"

    eda(df, col)

    scaler = MinMaxScaler()
    data = scaler.fit_transform(df[[col]])               # normalize

    X, y = make_windows(data, WINDOW)                    # (samples, 60, 1)
    split = int(0.8 * len(X))                            # chronological split, no shuffle
    X_tr, X_te, y_tr, y_te = X[:split], X[split:], y[:split], y[split:]

    results = {}
    for kind in ["RNN", "LSTM", "GRU"]:
        model = build_model(kind)
        model.fit(X_tr, y_tr, epochs=20, batch_size=32, validation_split=0.1,
                  callbacks=[EarlyStopping(patience=3, restore_best_weights=True)], verbose=0)
        pred = scaler.inverse_transform(model.predict(X_te))
        true = scaler.inverse_transform(y_te)
        rmse = np.sqrt(mean_squared_error(true, pred))
        mae = mean_absolute_error(true, pred)
        results[kind] = (rmse, mae)
        plt.plot(pred, label=kind)

    plt.plot(true, label="Actual", color="k"); plt.legend(); plt.title("Forecast Comparison"); plt.show()
    print(pd.DataFrame(results, index=["RMSE", "MAE"]))

if __name__ == "__main__":
    main()
